# ==========================================
# Baza Danych (PostgreSQL + pgvector)
# ==========================================
POSTGRES_USER=agent
POSTGRES_PASSWORD=12345678
POSTGRES_DB=ai_memory

MEMORY_PG_HOST=postgres
MEMORY_PG_PORT=5432
MEMORY_PG_USER=agent
MEMORY_PG_PASSWORD=12345678
MEMORY_PG_DATABASE=ai_memory

OBSIDIAN_HOST_PATH=/mnt/c/Users/macie/Documents/Moje

# ==========================================
# Mapowanie Modeli Ollama do Ról AI (Zgodne z config.yaml)
# ==========================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=8192
CODE_MODEL=qwen2.5-coder:7b
REASONING_MODEL=deepseek-r1:8b
TEXT_MODEL=llama3.1
VISION_MODEL=qwen2.5vl
EMBEDDING_MODEL=mxbai-embed-large

# ==========================================
# TDAI / TencentDB Agent Memory
# ==========================================
STATE_BACKEND=database
DB_DIALECT=postgres
TDAI_LLM_BASE_URL=http://ollama:11434/v1
TDAI_LLM_API_KEY=ollama
TDAI_LLM_MODEL=llama3.1