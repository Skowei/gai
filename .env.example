# ==============================================================================
# AI Ecosystem V2.0 - Environment Variables
# ==============================================================================

# ==============================================================================
# BASE 1: PostgreSQL 16 + pgvector (Baza danych & RAG)
# ==============================================================================
DATABASE_URL=postgresql://agent:your_secure_password@postgres:5432/ai_workspace
POSTGRES_PASSWORD=change_this_in_production
PGVECTOR_ENABLED=true

# ==============================================================================
# BASE 2: Redis 7 Alpine (Semantic Cache - szybkie odpowiedzi bez GPU)
# ==============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_MAX_MEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ==============================================================================
# MEMORY HUB: PostgreSQL + Redis (ZAMIENIONO TencentDB Agent Memory)
# ==============================================================================
MEMORY_PG_DATABASE=ai_memory  # Oddzielna baza dla pamięci agenta
MEMORY_REDIS_DB=1            # Redis DB dla krótkoterminowej pamięci
MEMORY_ENABLED=true

# ==============================================================================
# MEMORY PG CREDENTIALS - Wymagane dla połączenia z PostgreSQL
# ==============================================================================
MEMORY_PG_USER=agent         # Użytkownik bazy danych (domyślnie: agent)
MEMORY_PG_PASSWORD=your_secure_password  # Hasło do bazy danych pamięci
MEMORY_PG_HOST=localhost      # Host serwera PostgreSQL
MEMORY_PG_PORT=5432          # Port dla PostgreSQL

# ==============================================================================
# Ollama & Modele (Domyślny URL - działa na Linux host.docker.internal)
# ==============================================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=4096

# Mapowanie modeli do ról AI:
# - Kod/SQL/XML/SVG: qwen2.5-coder:7b-instruct
# - Logika/Reasoning: deepseek-r1:8b (lub qwen3.5/phi-4 jako fallback)
# - Tekst/Obsidian/PL: llama3.1:8b-instruct
# - Vision/Grafiki: qwen2-vl:7b-instruct
# - Embeddings: bge-m3

CODE_MODEL=qwen2.5-coder:7b-instruct
REASONING_MODEL=deepseek-r1:8b
TEXT_MODEL=llama3.1:8b-instruct
VISION_MODEL=qwen2-vl:7b-instruct
EMBEDDING_MODEL=bge-m3

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
API_PORT=8000
LOG_LEVEL=INFO
WORKER_COUNT=4
RECURSION_LIMIT=10  # Limit kroków w LangGraph (zabezpieczenie przed pętlami)

# ==============================================================================
# SECURITY: SQL Guardrail
# ==============================================================================
SQLITE_READ_ONLY_DB=true  # Główna baza - tylko SELECT dla agenta
ALLOWED_SQL_OPERATIONS=SELECT,SHOW,DESCRIBE,EXPLAIN  # Lista dozwolonych operacji

# ==============================================================================
# BACKUP SETTINGS
# ==============================================================================
BACKUP_RETENTION_DAYS=30  # Ile dni trzymać backupy w miejscu
BACKUP_NOTIFICATION_EMAIL=admin@example.com  # Opcjonalnie: powiadomienia