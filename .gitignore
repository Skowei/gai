# =============================================================================
# AI Ecosystem V2.0 - Plik ignorowanych zasobów Git
# =============================================================================

# --- DANE ŚRODOWISKA ---
# Ignorujemy żywe pliki baz danych oraz notatki Obsidian, bo to Twoje dane prywatne
data/

# --- LOGIKA AUTOMATYZACJI I KOPII ZAPASOWYCH ---
# Ignorujemy wszystkie wygenerowane pliki ZIP w Twoim folderze backups/.
# Dzięki temu skrypty dump.sh, restore.sh oraz schema.sql polecą do Gita,
# ale ciężkie i prywatne paczki ZIP z bazami danych zostaną tylko lokalnie.
backups/*.zip

# --- SEKRETY ---
# Bezwzględnie ignorujemy plik konfiguracyjny z hasłami i kluczami API
.env
*.local

# --- PYTHON (Wirtualne środowiska i pliki tymczasowe) ---
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.eggs/
dist/
build/
*.egg-info/

# --- USTAWIENIA IDE / EDYTORÓW KODU ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- PLIKI SYSTEMOWE ---
.DS_Store
Thumbs.db

# --- OLLAMA (Lokalne modele) ---
# Jeśli pobierasz modele wewnątrz projektu, nie wypychamy gigabajtowych wag do Gita
ollama/.ollama/models/
